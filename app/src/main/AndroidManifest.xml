<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Envoyer les séances, et savoir si le réseau donne vraiment accès à Internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Demandées ensemble, au clic sur « Ajouter ma position » : l'utilisateur choisit la précision. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 13+ : demandée au clic sur « Activer les rappels », jamais au lancement. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Le suivi de course : un foreground service de type « location » (exigé depuis Android 14). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Ajoutée d'office par Firebase Analytics : pas de publicité, donc pas d'identifiant publicitaire. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Idem pour la Privacy Sandbox (attribution publicitaire) : rien à mesurer côté pub. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <!-- Pas de permission CAMERA : l'appareil photo du système prend la photo à notre place.
         La déclarer obligerait au contraire à la demander avant d'ouvrir cet appareil photo. -->

    <application
        android:name=".PulseTrackApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PulseTrack">

        <!-- singleTop : un clic sur une notification réutilise l'écran ouvert (onNewIntent). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Link : les liens du site s'ouvrent ici, sans menu de choix, si l'OS a vérifié
                 /.well-known/assetlinks.json (autoVerify). Seule la page d'accueil : /api, /sessions.md… restent au site. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="pulsetrackisco.netlify.app"
                    android:path="/" />
            </intent-filter>
        </activity>

        <!-- Le suivi de course : mesure en continu, écran éteint. Démarré seulement depuis l'écran. -->
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Réveillé par l'OS quand un push FCM arrive, même app tuée. Jamais lancé par l'app. -->
        <service
            android:name=".notif.PulseTrackMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Analytics : rien ne part avant le « oui » de l'utilisateur (Analytics.setConsent). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <!-- Les écrans sont nommés à la main : le suivi automatique ne verrait que MainActivity (double comptage). -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Canal utilisé si un message « notification » (console Firebase) arrive app fermée. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reminders" />

        <!-- Donne à l'appareil photo et aux apps de partage un accès temporaire à un seul fichier. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
