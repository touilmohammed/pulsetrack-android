    <string name="settings_title">Réglages</string>
    <string name="reminders_title">Rappels d\'entraînement</string>
    <string name="reminders_intro">Recevez une notification les jours et à l\'heure de votre choix pour ne pas oublier votre séance. Au clic sur « Activer », Android vous demandera l\'autorisation d\'afficher des notifications.</string>
    <string name="reminders_unavailable">Rappels indisponibles dans cette version de l\'app : Firebase n\'est pas configuré (google-services.json absent).</string>
    <string name="reminders_days">Jours</string>
    <string name="reminders_hour">Heure</string>
    <string name="reminders_enable">Activer les rappels</string>
    <string name="reminders_update">Mettre à jour les rappels</string>
    <string name="reminders_test">Envoyer un rappel de test</string>
    <string name="reminders_disable">Désactiver les rappels</string>
    <string name="reminders_status_on">Rappels activés : %1$s à %2$d h.</string>
    <string name="reminders_status_off">Rappels désactivés.</string>
    <string name="reminders_status_test">Rappel de test envoyé : il doit arriver dans quelques secondes.</string>
    <string name="reminders_status_offline">Pas de connexion : réessayez une fois en ligne.</string>
    <string name="reminders_status_no_days">Choisissez au moins un jour.</string>
    <string name="notifications_rationale_title">Pourquoi les notifications ?</string>
    <string name="notifications_rationale">Sans elles, Android ne peut pas afficher vos rappels d\'entraînement. PulseTrack ne vous notifie que pour ces rappels et, en silence, quand des séances enregistrées hors ligne sont arrivées.</string>
    <string name="notifications_denied_forever">Les notifications sont désactivées pour PulseTrack. Vous pouvez les autoriser dans les réglages ; le reste de l\'app fonctionne sans.</string>

    <string name="consent_title">Mesure d\'audience</string>
    <string name="consent_text">Pour améliorer PulseTrack, acceptez-vous l\'envoi de statistiques d\'usage anonymes (écrans ouverts, séances créées, suivis GPS) ? Ni vos notes, ni vos positions, ni votre identité ne sont envoyées. Sans votre accord, rien ne part et l\'app fonctionne pareil.</string>
    <string name="consent_yes">Oui</string>
    <string name="consent_no">Non</string>
    <string name="consent_setting">Statistiques d\'usage anonymes (Firebase Analytics). Ni notes, ni positions, ni identité.</string>

    <string name="tracking_title">Suivi GPS</string>
    <string name="tracking_intro">Lancez le suivi au départ : PulseTrack mesure la distance et le temps, même écran éteint, téléphone dans la poche. Une notification reste affichée pendant la course. À l\'arrivée, la séance se remplit toute seule.</string>
